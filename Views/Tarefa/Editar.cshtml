@model  trilha_net_api_mvc_desafio.Models.Entities.Tarefa;
@using trilha_net_api_mvc_desafio.Models.Entities;

@{
    ViewData["Title"] = "Editar tarefa";
}

<h1>Editar tarefa atual</h1>
<hr>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Editar">
            <div class="form-group">
                <label asp-for="Titulo" class="control-label"></label>
                <input asp-for="Titulo" class="form-control">
            </div><div class="form-group">
                <label asp-for="Descricao" class="control-label"></label>
                <input asp-for="Descricao" class="form-control">
            </div>
            <div class="form-group">
                <label asp-for="Data" class="control-label"></label>
                <input asp-for="Data" class="form-control">
            </div>
            <div class="form-group">
                <label>Status</label> <br>

                <div class="form-check form-check-inline">
                    <input type="radio" class="form-check-input" value="@((int)EnumStatusTarefa.Pendente)" id="statusPendente" name="status" checked>
                    <label asp-for="Status" class="control-label" for="statusPendente">Pendente</label>
                </div>
                <div class="form-check form-check-inline">
                    <input type="radio" class="form-check-input" value="@((int)EnumStatusTarefa.Finalizado)" id="statusFinalizado" name="status">
                    <label asp-for="Status" class="control-label" for="statusFinalizado">Finalizado</label>
                </div>
            </div>
            <br>
            <div class="form-group">
                <input type="submit" value="Editar" class="btn btn-primary">
            </div>
        </form>
    </div>
</div>
<br>
<div>
    <a asp-action="Index">Voltar</a>
</div>